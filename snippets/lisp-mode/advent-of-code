  (:import-from :alexandria
                #:read-file-into-string)
  (:import-from :uiop/utility
                #:split-string)
  (:import-from :uiop
                #:read-file-lines)
  (:import-from :aoc-utils
                #:split-input
                #:read-input
                #:split-newline
                #:parse-integers
                #:log-error
                #:log-debug
                #:*log-level*
                #:break-error
                #:break-debug
                #:get-char
                #:set-char
                #:copy-map
                #:print-map
                #:valid-pos-p))

(in-package :day${1})


(defvar *input* (read-file-into-string "day${1}.txt"))

